# ─── Ebû Bekir er-Râzî'nin Kazanı — Ortam Değişkenleri ───────────────────────
# Bu dosyayı '.env' olarak kopyala ve değerleri doldur.
# cp .env.example .env

# ── Zorunlu ───────────────────────────────────────────────────────────────────

# Gemini API anahtarı — https://aistudio.google.com/app/apikey
# Boş bırakılırsa ipucu motoru devre dışı kalır (oyun yine çalışır).
GEMINI_API_KEY=

# ── Opsiyonel ─────────────────────────────────────────────────────────────────

# Pygame'in otomatik bulamadığı durumlarda yerel IP adresini zorla:
# RAZI_HOST=192.168.1.25

# Sunucu portu (varsayılan: 8000)
# PORT=8000

# ── Cloudflare Tunnel / İnternet Yayını (Aynı WiFi Zorunluluğunu Kaldırma) ─────
# cloudflared tüneli başlattığınızda veya sabit domain aldığınızda
# telefonların bağlanacağı internet adresini buraya yazın:
# RAZI_PLAY_URL=https://beyhekim.trycloudflare.com/play

# Veritabanı dizini (varsayılan: proje kökü)
# DB_DIR=.
